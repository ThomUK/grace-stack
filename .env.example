HF_TOKEN=hf_xxx
GRAFANA_ADMIN_USER=email@example.com
GRAFANA_ADMIN_PASSWORD=change-me

# Tailscale name of this machine, used for links in the Grafana dashboards
TAILNET_HOST=xyz.tail1234.ts.net

# choose which models come up when you run `docker compose up -d`
# others can be started with `docker compose --profile <profile> up -d <container name>`
# (comma-separated list of profiles)
COMPOSE_PROFILES=qwen36moe,qwen38

# Speculative decoding for vllm-qwen. Single-stream decode on GB10, measured by others:
#   none ................................ ~8 tok/s
#   built-in MTP, 3 drafts .............. ~17 tok/s   (safe default)
#   DFlash2 drafter, 7 drafts ........... ~32 tok/s   (needs TRITON_ATTN until vLLM > 0.31
#                                                     fixes prefix-cache garbling, issue #60174)
QWEN_SPEC={"method":"mtp","num_speculative_tokens":3}
#QWEN_SPEC={"method":"dflash","model":"z-lab/Qwen3.8-27B-DFlash2","num_speculative_tokens":7,"attention_backend":"TRITON_ATTN"}
