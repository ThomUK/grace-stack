HF_TOKEN=hf_xxx
GRAFANA_ADMIN_USER=email@example.com
GRAFANA_ADMIN_PASSWORD=change-me

# Tailscale name of this machine, used for links in the Grafana dashboards and the switchboard
TAILNET_HOST=xyz.tail1234.ts.net

# Switchboard (port 8080) refuses to start a model set whose GMU fractions sum above this.
MAX_GMU=0.85

# The switchboard's own login (password + authenticator) is set up in the browser on first visit,
# with a one-time token from `docker logs switchboard`; it lives in the switchboard-auth volume, not here.

# Pixel Dog (apps/pixel-dog, port 8765 on the LAN): a folder on this machine that holds the profiles
# and device tokens. The container runs as PIXELDOG_UID:PIXELDOG_GID (default 1000:1000), so that user must
# own it. PIXELDOG_PIPELINE is echo | fake | full; full needs the stt, kokoro and vllm-voice services.
PIXELDOG_DATA_DIR=/home/you/pixel-dog-data
#PIXELDOG_UID=1000
#PIXELDOG_GID=1000
#PIXELDOG_PIPELINE=echo                 # full, once stt, kokoro and the LLM below are up
# The LLM pixel-dog talks to, until a dedicated voice model exists (default http://vllm-voice:8000/v1, voice-llm).
# Any chat model in models/compose.yml works; thinking is switched off per request, not in the vLLM flags.
#PIXELDOG_DEFAULT_LLM_URL=http://vllm-qwen36moe:8000/v1
#PIXELDOG_DEFAULT_LLM_MODEL=qwen3.6-35b-a3b
# for weather tool calling
PIXELDOG_HOME_LAT=xx.xx
PIXELDOG_HOME_LON=-x.xx