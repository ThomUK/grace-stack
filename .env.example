HF_TOKEN=hf_xxx
GRAFANA_ADMIN_USER=email@example.com
GRAFANA_ADMIN_PASSWORD=change-me

# Tailscale name of this machine, used for links in the Grafana dashboards and the switchboard
TAILNET_HOST=xyz.tail1234.ts.net

# Switchboard (port 8080) refuses to start a model set whose GMU fractions sum above this.
MAX_GMU=0.85

# The switchboard's own login (password + authenticator) is set up in the browser on first visit,
# with a one-time token from `docker logs switchboard`; it lives in the switchboard-auth volume, not here.
