HF_TOKEN=hf_xxx
GRAFANA_ADMIN_USER=email@example.com
GRAFANA_ADMIN_PASSWORD=change-me

# Tailscale name of this machine, used for links in the Grafana dashboards and the switchboard
TAILNET_HOST=xyz.tail1234.ts.net

# Switchboard (port 8080) refuses to start a model set whose GMU fractions sum above this.
MAX_GMU=0.85

# Models are not configured here. Each quant / drafter combination is its own service in
# models/compose.yml, behind its own profile, so `docker compose up -d` leaves them alone:
# start them from the switchboard (presets), or `docker compose --profile ornith15-nvfp4 up -d vllm-ornith15-nvfp4`.
